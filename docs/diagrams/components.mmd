flowchart LR
    browser["Browser<br/>Livewire + Flux"]

    subgraph sail["docker compose"]
        app["laravel.test<br/>web (Livewire pages)"]
        queue["queue<br/>queue:work"]
        scheduler["scheduler<br/>schedule:work"]
        infra["infra<br/>fake infrastructure<br/>(own sqlite db)"]
