APP_NAME="Mini Cloud"
APP_ENV=production
APP_KEY=base64:REPLACE_WITH_RANDOM_32_BYTES_BASE64
APP_DEBUG=false
APP_URL=http://localhost:8085
LOG_CHANNEL=stderr
LOG_LEVEL=warning
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=minicloud
DB_USERNAME=minicloud
DB_PASSWORD=REPLACE_WITH_RANDOM_HEX
DB_ROOT_PASSWORD=REPLACE_WITH_DIFFERENT_RANDOM_HEX
SESSION_DRIVER=database
SESSION_SECURE_COOKIE=false
SESSION_ENCRYPT=true
QUEUE_CONNECTION=database
CACHE_STORE=database
MAIL_MAILER=log
INFRA_URL=http://infra/infra
FAKE_INFRA_FAIL_RATE=0.2
FAKE_INFRA_LIE_RATE=0.2
FAKE_INFRA_CREATE_DELAY=4
